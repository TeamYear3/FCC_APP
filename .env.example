# ==============================================================================
# FCC_APP - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como '.env' en la raíz y define tus valores locales.
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuración del Backend Django
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-local-dev-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ------------------------------------------------------------------------------
# Base de Datos Relacional - PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=fcc_app
POSTGRES_USER=fcc_user
POSTGRES_PASSWORD=fcc_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Base de Datos No Relacional - MongoDB
# ------------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_password
MONGO_URI=mongodb://mongo_admin:mongo_password@mongodb:27017/fcc_app?authSource=admin

# ------------------------------------------------------------------------------
# Servicio de Caché - Redis
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Autenticación y APIs de Terceros
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Configuración de Correo Electrónico (SMTP) - Mailtrap / SendGrid
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=tu_usuario_mailtrap
EMAIL_HOST_PASSWORD=tu_password_mailtrap
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FCC App <noreply@fccapp.com>
