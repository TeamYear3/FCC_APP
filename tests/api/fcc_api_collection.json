{
  "info": {
    "_postman_id": "7b093154-1b32-4759-9943-fcc_collection_v21",
    "name": "Full Check Car - API Test Suite",
    "description": "Colección modular de pruebas automatizadas de caja negra para la API REST de Full Check Car (Sprint 4). Incluye autenticación dinámica JWT, ciclo CRUD encadenado con propagación de ID y pruebas negativas (401 Unauthorized y 400 Bad Request) por cada recurso.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00_Auth",
      "description": "Módulo de autenticación y generación de credenciales JWT.",
      "item": [
        {
          "name": "Login - Obtener Token JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Respuesta es un JSON válido\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Respuesta contiene token access JWT\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"access\");",
                  "    pm.expect(jsonData.access).to.be.a(\"string\");",
                  "    pm.environment.set(\"authToken\", jsonData.access);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            },
            "description": "Autenticación de usuario para obtención e inyección dinámica del token JWT en {{authToken}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "01_Clientes",
      "description": "Módulo de gestión de clientes: ciclo CRUD encadenado y pruebas negativas de seguridad y validación.",
      "item": [
        {
          "name": "01 - Listar Clientes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Respuesta es JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Retorna una lista o respuesta paginada de clientes\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var clientes = Array.isArray(jsonData) ? jsonData : jsonData.results;",
                  "    pm.expect(clientes).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                ""
              ]
            },
            "description": "Consulta del directorio de clientes registrados en el taller."
          },
          "response": []
        },
        {
          "name": "02 - POST Crear Cliente (Captura ID)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomDni = Math.floor(10000000 + Math.random() * 89999999).toString();",
                  "pm.collectionVariables.set(\"tempDni\", randomDni);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Cliente creado contiene ID UUID y nombre esperado\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "    pm.expect(jsonData.nombre).to.eql(\"Cliente CRUD Temporal\");",
                  "    pm.collectionVariables.set(\"clienteId\", jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente CRUD Temporal\",\n  \"apellido\": \"Postman Test\",\n  \"tipo_documento\": \"DNI\",\n  \"dni_cuit\": \"{{tempDni}}\",\n  \"condicion_iva\": \"CF\",\n  \"email\": \"crud_{{$timestamp}}@qa.fcc.com\",\n  \"telefono\": \"3518887766\",\n  \"domicilio\": \"Av. Colon 5000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/clientes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                ""
              ]
            },
            "description": "Paso 1 del CRUD: Alta de cliente temporal y almacenamiento dinámico del ID en la variable de colección {{clienteId}}."
          },
          "response": []
        },
        {
          "name": "03 - GET Consultar Cliente por ID Dinámico",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"El registro coincide con el clienteId creado\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var idEsperado = pm.collectionVariables.get(\"clienteId\");",
                  "    pm.expect(jsonData.id).to.eql(idEsperado);",
                  "    pm.expect(jsonData.nombre).to.eql(\"Cliente CRUD Temporal\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/{{clienteId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                "{{clienteId}}",
                ""
              ]
            },
            "description": "Paso 2 del CRUD: Consulta del recurso utilizando el ID propagado dinámicamente desde el paso anterior."
          },
          "response": []
        },
        {
          "name": "04 - PATCH Modificar Cliente Creado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Campos actualizados correctamente\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.telefono).to.eql(\"3519991122\");",
                  "    pm.expect(jsonData.domicilio).to.eql(\"Nueva Direccion 789\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"3519991122\",\n  \"domicilio\": \"Nueva Direccion 789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/clientes/{{clienteId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                "{{clienteId}}",
                ""
              ]
            },
            "description": "Paso 3 del CRUD: Modificación parcial de datos sobre el cliente temporal utilizando PATCH."
          },
          "response": []
        },
        {
          "name": "05 - DELETE Eliminar Cliente (Teardown Hermético)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 204 No Content (eliminación exitosa)\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/{{clienteId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                "{{clienteId}}",
                ""
              ]
            },
            "description": "Paso 4 del CRUD: Eliminación del recurso temporal para dejar el entorno de prueba hermético y reproducible."
          },
          "response": []
        },
        {
          "name": "06 - GET Verificar Eliminación (404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 404 Not Found tras eliminación\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/{{clienteId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                "{{clienteId}}",
                ""
              ]
            },
            "description": "Paso 5 del CRUD: Verificación final comprobando que el recurso eliminado ya no existe en el sistema."
          },
          "response": []
        },
        {
          "name": "07 - Negativa: GET Clientes sin Token (401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 401 Unauthorized ante petición anónima\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Respuesta contiene mensaje de error de autenticación\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"detail\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                ""
              ]
            },
            "description": "Prueba negativa: Validación de rechazo HTTP 401 al consultar clientes sin cabecera Authorization."
          },
          "response": []
        },
        {
          "name": "08 - Negativa: POST Crear Cliente con Payload Inválido (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 400 Bad Request ante payload inválido\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Respuesta contiene estructura de errores de validación\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"object\");",
                  "    pm.expect(jsonData).to.have.any.keys(\"nombre\", \"dni_cuit\", \"email\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"apellido\": \"\",\n  \"dni_cuit\": \"documento_invalido_con_letras\",\n  \"email\": \"email-sin-formato-valido\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/clientes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                ""
              ]
            },
            "description": "Prueba negativa: Validación de rechazo HTTP 400 al enviar campos obligatorios vacíos o datos con formato inválido."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02_Ordenes",
      "description": "Módulo de gestión de órdenes de trabajo (OT) del taller y pruebas negativas.",
      "item": [
        {
          "name": "01 - Listar Órdenes de Trabajo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Respuesta es JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Retorna una colección de órdenes de trabajo\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var ordenes = Array.isArray(jsonData) ? jsonData : jsonData.results;",
                  "    pm.expect(ordenes).to.be.an(\"array\");",
                  "    if (ordenes.length > 0) {",
                  "        pm.collectionVariables.set(\"ordenExistenteId\", ordenes[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ordenes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ordenes",
                ""
              ]
            },
            "description": "Consulta del listado general de órdenes de trabajo con estado y datos de vehículo."
          },
          "response": []
        },
        {
          "name": "02 - Obtener Detalle de Orden de Trabajo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Detalle de la orden contiene estructura completa\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "    pm.expect(jsonData).to.have.property(\"estado\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ordenes/{{ordenExistenteId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ordenes",
                "{{ordenExistenteId}}",
                ""
              ]
            },
            "description": "Consulta detallada del expediente de una orden de trabajo por su identificador UUID."
          },
          "response": []
        },
        {
          "name": "03 - Negativa: GET Órdenes sin Token (401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 401 Unauthorized al listar órdenes sin token\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Respuesta contiene detalle de autenticación requerida\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"detail\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ordenes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ordenes",
                ""
              ]
            },
            "description": "Prueba negativa: Validación de rechazo HTTP 401 al consultar órdenes sin autenticación."
          },
          "response": []
        },
        {
          "name": "04 - Negativa: POST Crear Orden con Payload Inválido (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 400 Bad Request ante payload inválido en orden\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Respuesta contiene errores de validación estructurados\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"object\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
